+void GbaPpu::set_obj_palette_override(unsigned bank, const uint16_t* colors) {
+    if (bank > 15) return;
+    if (!colors) { obj_override_mask_ = uint16_t(obj_override_mask_ & ~(1u << bank)); return; }
+    std::memcpy(&obj_override_[bank * 16], colors, 16 * sizeof(uint16_t));
+    obj_override_mask_ = uint16_t(obj_override_mask_ | (1u << bank));
+}
+
+const uint8_t* GbaPpu::presentation_palette(const uint8_t* pal) {
+    if (!obj_override_mask_ || !pal) return pal;
+    std::memcpy(pal_scratch_.data(), pal, pal_scratch_.size());
+    for (unsigned bank = 0; bank < 16; ++bank) {
+        if (!(obj_override_mask_ & (1u << bank))) continue;
+        for (unsigned i = 1; i < 16; ++i) {  // entry 0 stays transparent
+            const uint16_t c = obj_override_[bank * 16 + i];
+            pal_scratch_[0x200 + bank * 32 + i * 2] = uint8_t(c & 0xFF);
+            pal_scratch_[0x200 + bank * 32 + i * 2 + 1] = uint8_t(c >> 8);
+        }
+    }
+    return pal_scratch_.data();
+}
