+void bios_hle_native_boot(gbarecomp::RuntimeArmContext& context, GbaBus& bus, uint32_t cart_entry) {
+    // The bios_hle_boot_skip() handoff state for a machine that is not the
+    // active one (multiplayer sessions keep one CPU context per console).
+    bios_hle_set_mode(BiosHleMode::Native);
+    bios_hle_set_interrupts_enabled(true);
+    context.bios_hook = g_bios_hle_hook;
+    context.bios_dispatch_hook = g_bios_hle_dispatch_hook;
+    ArmCpuState& cpu = context.cpu;
+    cpu = ArmCpuState{};
+    cpu.banked_sp[ARM_BANK_SUPERVISOR] = 0x03007FE0u;
+    cpu.banked_sp[ARM_BANK_IRQ]        = 0x03007FA0u;
+    cpu.banked_sp[ARM_BANK_USER]       = 0x03007F00u;
+    cpu.R[13] = 0x03007F00u;
+    cpu.cpsr  = 0x0000001Fu;
+    cpu.R[15] = cart_entry;
+    bus.enable_native_bios();
+    bus.write32(0x03007FFCu, 0);
+    bus.write16(0x04000134u, 0x8000u);
+    bus.write8(0x04000300u, 1u);
+    bus.latch_bios_prefetch(0xdcu, false);
