+// RegisterRamReset (SWI 0x01), from the GBATEK description: r0 selects the
+// memory and register groups to clear. Needed when no BIOS image is present.
+void do_register_ram_reset() {
+    const uint32_t flags = R(0);
+    auto fill = [](uint32_t base, uint32_t size) {
+        for (uint32_t a = 0; a < size; a += 4) wr32(base + a, 0);
+    };
+    wr16(0x04000000u, 0x0080u);                        // DISPCNT: forced blank
+    if (flags & 0x01u) fill(0x02000000u, 0x40000u);    // on-board WRAM
+    if (flags & 0x02u) fill(0x03000000u, 0x7E00u);     // on-chip WRAM, stack area kept
+    if (flags & 0x04u) fill(0x05000000u, 0x400u);      // palette
+    if (flags & 0x08u) fill(0x06000000u, 0x18000u);    // VRAM
+    if (flags & 0x10u) fill(0x07000000u, 0x400u);      // OAM
+    if (flags & 0x20u) {                               // serial: general-purpose mode
+        for (uint32_t a = 0x04000120u; a < 0x0400012Cu; a += 2) wr16(a, 0);
+        wr16(0x04000134u, 0x8000u);
+        wr16(0x04000140u, 0);
+        for (uint32_t a = 0x04000150u; a < 0x04000159u; a += 2) wr16(a, 0);
+    }
+    if (flags & 0x40u) {                               // sound
+        wr16(0x04000084u, 0);                          // master off clears the PSG registers
+        for (uint32_t a = 0x04000060u; a < 0x04000084u; a += 2) wr16(a, 0);
+        for (uint32_t a = 0x04000090u; a < 0x040000A8u; a += 2) wr16(a, 0);
+        wr16(REG_SOUNDBIAS, 0x0200u);
+    }
+    if (flags & 0x80u) {                               // every other register
+        for (uint32_t a = 0x04000002u; a < 0x04000060u; a += 2) wr16(a, 0);
+        wr16(0x04000020u, 0x0100u); wr16(0x04000026u, 0x0100u);   // BG2PA, BG2PD
+        wr16(0x04000030u, 0x0100u); wr16(0x04000036u, 0x0100u);   // BG3PA, BG3PD
+        for (uint32_t a = 0x040000B0u; a < 0x04000110u; a += 2) wr16(a, 0);
+        wr16(0x04000200u, 0); wr16(0x04000202u, 0xFFFFu);          // IE, IF (acknowledge)
+        wr16(0x04000204u, 0); wr16(0x04000208u, 0);                // WAITCNT, IME
+    }
+}
